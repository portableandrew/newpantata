generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Position {
  PG
  SG
  SF
  PF
  C
}

enum DrillCategory {
  Shooting
  Defense
  Conditioning
  BallHandling  @map("Ball Handling")
  Rebounding
  Team
  Footwork
}

enum Difficulty {
  Beginner
  Intermediate
  Advanced
}

enum SessionType {
  Practice
  Game
  FilmSession  @map("Film Session")
  Conditioning
  Scrimmage
}

enum StatType {
  Game
  Practice
  Scrimmage
}

model Player {
  id           String   @id @default(uuid())
  name         String
  position     Position
  jerseyNumber Int?     @map("jersey_number")
  age          Int?
  heightCm     Int?     @map("height_cm")
  weightKg     Int?     @map("weight_kg")
  teamGroup    String?  @map("team_group")
  notes        String?
  isActive     Boolean  @default(true) @map("is_active")
  joinedAt     DateTime @default(now()) @map("joined_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  stats       PlayerStat[]
  attendances SessionAttendance[]

  @@map("players")
}

model Drill {
  id           String        @id @default(uuid())
  name         String
  category     DrillCategory
  description  String?
  difficulty   Difficulty    @default(Intermediate)
  durationMins Int?          @map("duration_mins")
  instructions String?
  tags         String[]      @default([])
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  sessionDrills SessionDrill[]

  @@map("drills")
}

model TrainingSession {
  id           String      @id @default(uuid())
  title        String
  sessionType  SessionType @map("session_type")
  date         DateTime
  durationMins Int?        @map("duration_mins")
  location     String?
  notes        String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  drills      SessionDrill[]
  attendances SessionAttendance[]

  @@map("training_sessions")
}

model SessionDrill {
  id           String          @id @default(uuid())
  sessionId    String          @map("session_id")
  drillId      String          @map("drill_id")
  orderIndex   Int             @map("order_index")
  sets         Int?
  reps         Int?
  durationMins Int?            @map("duration_mins")
  notes        String?
  createdAt    DateTime        @default(now()) @map("created_at")

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  drill   Drill           @relation(fields: [drillId], references: [id])

  @@unique([sessionId, orderIndex])
  @@map("session_drills")
}

model SessionAttendance {
  id        String          @id @default(uuid())
  sessionId String          @map("session_id")
  playerId  String          @map("player_id")
  attended  Boolean         @default(true)
  notes     String?
  createdAt DateTime        @default(now()) @map("created_at")

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player          @relation(fields: [playerId], references: [id])

  @@unique([sessionId, playerId])
  @@map("session_attendances")
}

model PlayerStat {
  id                  String   @id @default(uuid())
  playerId            String   @map("player_id")
  statDate            DateTime @map("stat_date")
  statType            StatType @map("stat_type")
  points              Int      @default(0)
  rebounds            Int      @default(0)
  assists             Int      @default(0)
  steals              Int      @default(0)
  blocks              Int      @default(0)
  turnovers           Int      @default(0)
  fieldGoalsMade      Int      @default(0) @map("field_goals_made")
  fieldGoalAttempts   Int      @default(0) @map("field_goal_attempts")
  threesMade          Int      @default(0) @map("threes_made")
  threesAttempts      Int      @default(0) @map("threes_attempts")
  freeThrowsMade      Int      @default(0) @map("free_throws_made")
  freeThrowAttempts   Int      @default(0) @map("free_throw_attempts")
  minutesPlayed       Int      @default(0) @map("minutes_played")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [id])

  @@map("player_stats")
}
